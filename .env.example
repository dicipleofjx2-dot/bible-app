# Copy this file to .env and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 아래 둘은 선택이다. 없으면 그 기능만 조용히 꺼진다.
# 말씀카드 카카오톡 공유(웹 전용) — developers.kakao.com > 앱 설정 > 플랫폼 키 > JavaScript 키
# EXPO_PUBLIC_KAKAO_JS_KEY=
# 웹 푸시 알림
# EXPO_PUBLIC_VAPID_PUBLIC_KEY=
