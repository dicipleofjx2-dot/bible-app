# Supabase — 브라우저에서도 쓰므로 NEXT_PUBLIC_ 이다. 표의 정책이 본인 것만 열어 준다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 워드프레스 — 서버(라우트)에서만 읽는다. NEXT_PUBLIC_ 을 붙이면 안 된다.
# 애플리케이션 비밀번호는 워드프레스 관리자 → 사용자 → 프로필 → 애플리케이션
# 비밀번호에서 발급한다. 로그인 비밀번호가 아니다.
WORDPRESS_URL=https://your-blog.example.com
WORDPRESS_USER=your-wp-login
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
