{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/arena/escape/:roomId", "destination": "/arena/escape/[roomId]" },
    { "source": "/arena/duel/:duelId", "destination": "/arena/duel/[duelId]" },
    { "source": "/library/:id/read", "destination": "/library/[id]/read" },
    { "source": "/library/:id", "destination": "/library/[id]" },
    { "source": "/notice-board/:id", "destination": "/notice-board/[id]" },
    { "source": "/plans/:slug", "destination": "/plans/[slug]" },
    { "source": "/post/:id", "destination": "/post/[id]" },
    { "source": "/r2m/courses/:id", "destination": "/r2m/courses/[id]" },
    { "source": "/shepherd-letters/:id", "destination": "/shepherd-letters/[id]" },
    { "source": "/word-notes/:id", "destination": "/word-notes/[id]" }
  ]
}
