{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/library/:id/read", "destination": "/library/[id]/read.html" },
    { "source": "/library/:id", "destination": "/library/[id].html" },
    { "source": "/notice-board/:id", "destination": "/notice-board/[id].html" },
    { "source": "/plans/:slug", "destination": "/plans/[slug].html" },
    { "source": "/post/:id", "destination": "/post/[id].html" },
    { "source": "/r2m/courses/:id", "destination": "/r2m/courses/[id].html" },
    { "source": "/shepherd-letters/:id", "destination": "/shepherd-letters/[id].html" },
    { "source": "/word-notes/:id", "destination": "/word-notes/[id].html" }
  ]
}
